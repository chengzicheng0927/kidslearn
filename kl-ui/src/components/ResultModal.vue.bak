<script setup lang="ts">
import { computed, ref } from 'vue'
import { storeToRefs } from 'pinia'
import { useAppStore } from '../stores/appStore'
import TwemojiText from './TwemojiText.vue'

const props = defineProps<{
  isCorrect: boolean
  resultMode?: 'correct' | 'wrong' | 'reward'
  combo: number
  accuracy: number
  timeSpent: number
  xp: number
  xpNeeded: number
  level: number
  rewardIcon?: string
  rewardTitle?: string
  rewardSub?: string
  explanation?: string
  explanationSteps?: string[]
  encouragement?: string
  correctAnswerText?: string
}>()

const emit = defineEmits<{
  (e: 'next'): void
}>()

const store = useAppStore()
const { child, todayStars, todayMaxStars } = storeToRefs(store)

const isExplaining = ref(false)

function stopExplanation() {
  if ('speechSynthesis' in window) speechSynthesis.cancel()
  isExplaining.value = false
}

function doSpeakExplanation() {
  if (isExplaining.value) speechSynthesis.cancel()

  const text = props.explanationSteps?.length
    ? `正确答案：${props.correctAnswerText}。${props.explanationSteps.join('。')}`
    : props.explanation
    ? `正确答案：${props.correctAnswerText}。${props.explanation}`
    : `正确答案：${props.correctAnswerText}。${props.encouragement ?? ''}`

  const safeText = text.trim().replace(/[。.！!?！?]$/, '') + '。'
  const utterance = new SpeechSynthesisUtterance(safeText)
  utterance.lang = 'zh-CN'
  utterance.rate = 0.7
  utterance.pitch = 1.0
  utterance.volume = 1.0

  const voices = speechSynthesis.getVoices()
  const zhVoice = voices.find(v => v.lang === 'zh-CN')
    || voices.find(v => v.lang.startsWith('zh'))
  if (zhVoice) utterance.voice = zhVoice

  utterance.onstart = () => { isExplaining.value = true }
  utterance.onend = () => { isExplaining.value = false }
  utterance.onerror = () => { isExplaining.value = false }
  speechSynthesis.speak(utterance)
}

function speakExplanation() {
  if (!('speechSynthesis' in window)) return

  const voices = speechSynthesis.getVoices()
  if (voices.length > 0) {
    doSpeakExplanation()
    return
  }

  const handler = () => {
    speechSynthesis.removeEventListener('voiceschanged', handler)
    doSpeakExplanation()
  }
  speechSynthesis.addEventListener('voiceschanged', handler)
  setTimeout(() => {
    speechSynthesis.removeEventListener('voiceschanged', handler)
    const v2 = speechSynthesis.getVoices()
    if (v2.length > 0) doSpeakExplanation()
  }, 500)
}

const resolvedMode = computed(() => {
  if (props.resultMode) return props.resultMode
  return props.isCorrect ? 'correct' : 'wrong'
})

const isReward = computed(() => resolvedMode.value === 'reward')
const isWrong = computed(() => resolvedMode.value === 'wrong')
const isCorrect = computed(() => resolvedMode.value === 'correct')
const childName = computed(() => child?.name ?? '小朋友')
const actionLabel = computed(() => (isWrong.value ? '我记住了，继续 →' : '继续下一题 →'))
const titleText = computed(() => {
  if (isReward.value) return `太棒了${childName.value}！`
  return isWrong.value ? '哎呀，答错了' : '太棒了！答对了！'
})
const subtitleText = computed(() => {
  if (isReward.value) return '连续答对触发奖励，快来收下这份鼓励'
  return isWrong.value ? '没关系，我来帮你讲解，下次一定能答对' : '小星老师给你点个大大的赞'
})
</script>

<template>
  <Teleport to="body">
    <div class="overlay" :class="{ wrong: isWrong, correct: isCorrect || isReward }">
      <div class="sheet" :class="{ correct: isCorrect || isReward }">
        <div class="sheet-top" :class="{ wrong: isWrong }">
          <div class="status-ring" :class="{ wrong: isWrong }">
            <svg v-if="!isWrong" viewBox="0 0 44 44" fill="none" width="44" height="44" aria-hidden="true">
              <path
                d="M8 22L18 32L36 12"
                stroke="white"
                stroke-width="4.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-dasharray="48"
                stroke-dashoffset="48"
                style="animation: drawCheck .5s .2s ease forwards"
              />
            </svg>
            <svg v-else viewBox="0 0 36 36" fill="none" width="36" height="36" aria-hidden="true">
              <path
                d="M10 10L26 26M26 10L10 26"
                stroke="white"
                stroke-width="4"
                stroke-linecap="round"
                stroke-dasharray="45"
                stroke-dashoffset="45"
                style="animation: drawCheck .4s .15s ease forwards"
              />
            </svg>
          </div>
          <div class="sheet-title">{{ titleText }}</div>
          <div class="sheet-sub">{{ subtitleText }}</div>
        </div>

        <div v-if="!isWrong" class="correct-body">
          <TwemojiText tag="div" class="teacher-emoji" text="🥳" />
          <TwemojiText tag="div" class="score-pop" :text="`🌟 今日 ${todayStars}/${todayMaxStars}`" />
          <TwemojiText v-if="combo > 1" tag="div" class="combo-pill" :text="`🔥 连续答对 ${combo} 题`" />

          <!-- 简洁奖励信息 -->
          <div v-if="isReward && rewardTitle" class="reward-badge">
            <TwemojiText tag="div" class="reward-badge-icon" :text="rewardIcon ?? ''" />
            <div class="reward-badge-copy">
              <div class="reward-badge-title">{{ rewardTitle }}</div>
              <div class="reward-badge-sub">{{ rewardSub }}</div>
            </div>
          </div>

          <div class="xp-block">
            <div class="xp-head">
              <span>等级 {{ level }}</span>
              <span>{{ xp }} / {{ xpNeeded }} XP</span>
            </div>
            <div class="xp-track">
              <div class="xp-fill" :style="{ width: `${Math.min(100, (xp / Math.max(1, xpNeeded)) * 100)}%` }"></div>
            </div>
          </div>
        </div>

        <div v-else class="wrong-body">
          <div class="teacher-mini">
            <TwemojiText tag="div" class="teacher-mini-icon" text="🌟" />
            <div class="teacher-mini-bubble">
              正确答案是 <strong>{{ correctAnswerText }}</strong>，来看看为什么吧
            </div>
          </div>

          <div class="explain-card">
            <div class="explain-icon">💡</div>
            <div class="explain-value">{{ correctAnswerText }}</div>
            <div class="explain-text">
              {{ explanation || (explanationSteps ? explanationSteps[0] : '') }}
            </div>
            <button class="explain-speak" @click.stop="speakExplanation">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M5 9H8L13 5V19L8 15H5V9Z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
                <path d="M16 8.5C17.8 9.9 19 11.9 19 14C19 16.1 17.8 18.1 16 19.5" stroke="white" stroke-width="2" stroke-linecap="round"/>
              </svg>
              听老师讲
            </button>
          </div>

          <div v-if="encouragement" class="encouragement">{{ encouragement }}</div>
        </div>

        <button class="action-btn" :class="{ wrong: isWrong }" @click="stopExplanation(); emit('next')">
          {{ actionLabel }}
        </button>
      </div>
    </div>
  </Teleport>
</template>

